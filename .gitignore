# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler cache; keep committed local path config.
/.bundle/*
!/.bundle/config
/vendor/bundle

# Ignore all environment files.
/.env*
!/.env.example

/packages/code-reviewer/.env

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

/node_modules
/packages/code-reviewer/node_modules

# Playwright MCP session snapshots (local browser automation).
/.playwright-mcp/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Cursor hook runtime state (per-conversation QA failures).
/.cursor/hooks/state/

# 10xDevs course skills — local only (installed via 10x-cli, never commit).
/.cursor/skills/
/.cursor/rules/
/.cursor/prompts/
/.cursor/.10x-cli-manifest.json

# Ignore key files for decrypting credentials and more.
/config/*.key
