# Code reviewer — optional overrides.
# Copy to .env only when this package needs settings different from the app.
#
# Load order:
#   1. repo root .env        (fallback — same OPENAI_API_KEY as SafeLog)
#   2. packages/code-reviewer/.env  (overrides keys defined here)
#
# If this file does not exist, root .env is enough.

# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Review-only model (falls back to OPENAI_MODEL from root .env)
# CODE_REVIEWER_MODEL=gpt-4o
