<section class="card">
  <h2>Hypothesis report</h2>

  <% if ai_report.nil? %>
    <p class="card__hint">No analysis has been run yet.</p>
  <% elsif ai_report.generated? && structured.present? %>
    <p><strong>Summary:</strong> <%= structured["summary"] %></p>

    <h3>Hypotheses</h3>
    <ol class="hypothesis-list">
      <% Array(structured["hypotheses"]).each do |hypothesis| %>
        <li>
          <strong><%= hypothesis["title"] %></strong>
          — <%= hypothesis["description"] %>
          <% if hypothesis["confidence"].present? %>
            <em>(<%= hypothesis["confidence"] %>)</em>
          <% end %>
        </li>
      <% end %>
    </ol>

    <h3>Uncertainty</h3>
    <ul>
      <% Array(structured["uncertainty_notes"]).each do |note| %>
        <li><%= note %></li>
      <% end %>
    </ul>

    <% if structured["correlation_highlights"].present? %>
      <h3>Correlation highlights</h3>
      <ul>
        <% Array(structured["correlation_highlights"]).each do |highlight| %>
          <li><%= highlight %></li>
        <% end %>
      </ul>
    <% end %>

    <% if ai_report.markdown_body.present? %>
      <div class="report-markdown">
        <h3>Markdown export</h3>
        <p class="card__hint">Select all and copy the Markdown below, or <%= link_to "download the report", download_report_debugging_case_path(debugging_case) %>.</p>
        <textarea readonly rows="12" aria-label="Report Markdown"><%= ai_report.markdown_body %></textarea>
      </div>
    <% end %>
  <% elsif ai_report.failed? %>
    <p class="callout callout--danger"><%= Analysis::AnalyzeCase::FAILURE_MESSAGE %></p>
  <% else %>
    <p class="card__hint">Analysis is in progress.</p>
  <% end %>
</section>
