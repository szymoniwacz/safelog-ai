<header class="page-header">
  <h1>Debugging cases</h1>
</header>

<div class="page-actions">
  <%= link_to "New debugging case", new_debugging_case_path, class: "btn" %>
  <%= link_to "Dashboard", root_path %>
</div>

<nav class="filter-tabs" aria-label="Case list filter">
  <%= link_to "Active", debugging_cases_path, aria: { current: (@show_archived ? "false" : "page") } %>
  <%= link_to "Archived", debugging_cases_path(filter: "archived"), aria: { current: (@show_archived ? "page" : "false") } %>
</nav>

<% if @debugging_cases.any? %>
  <table class="data-table">
    <thead>
      <tr>
        <th>Title</th>
        <th>Environment</th>
        <th>Created</th>
      </tr>
    </thead>
    <tbody>
      <% @debugging_cases.each do |debugging_case| %>
        <tr>
          <td><%= link_to debugging_case.title, debugging_case_path(debugging_case) %></td>
          <td><%= debugging_case.environment.presence || "—" %></td>
          <td><%= l(debugging_case.created_at, format: :short) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="empty-state">
    <% if @show_archived %>
      No archived debugging cases.
    <% else %>
      No active debugging cases yet. <%= link_to "Create one", new_debugging_case_path %>.
    <% end %>
  </p>
<% end %>
