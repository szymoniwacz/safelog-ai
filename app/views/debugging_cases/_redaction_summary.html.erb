<% if summary.any? %>
  <section class="card">
    <h2>Redaction summary</h2>
    <p class="card__hint">Sensitive patterns were replaced with placeholders before storage.</p>

    <table class="data-table">
      <thead>
        <tr>
          <th>Type</th>
          <th>Risk</th>
          <th>Count</th>
        </tr>
      </thead>
      <tbody>
        <% summary.each do |(finding_type, risk_level), count| %>
          <tr>
            <td><%= finding_type_label(finding_type) %></td>
            <td><%= risk_level %></td>
            <td><%= count %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </section>
<% end %>
