<header class="page-header">
  <h1><%= @debugging_case.title %></h1>
</header>

<div class="page-actions">
  <%= link_to "All cases", debugging_cases_path %>
  <%= link_to "New debugging case", new_debugging_case_path %>
  <%= link_to "Edit case", edit_debugging_case_path(@debugging_case) %>
  <%= link_to "Dashboard", root_path %>
  <% unless @debugging_case.archived? %>
    <%= button_to "Archive case", archive_debugging_case_path(@debugging_case), method: :post, class: "btn btn--danger" %>
  <% end %>
  <%= destroy_debugging_case_button(@debugging_case) %>
</div>

<section class="card card--highlight">
  <h2>Analysis</h2>
  <p class="card__hint">Generate correlation signals and a hypothesis-framed debugging report from sanitized evidence only.</p>
  <% if @fake_ai_client_active %>
    <p class="callout callout--info"><em>Demo AI client active — analyze returns sample output until OPENAI_API_KEY is configured.</em></p>
  <% end %>
  <div class="analyze-form">
    <%= button_to "Analyze case",
          analyze_debugging_case_path(@debugging_case),
          method: :post,
          class: "btn",
          form: { id: "analyze-case-form", class: "analyze-form__form" },
          id: "analyze-case-submit" %>
    <p class="analyze-form__status" id="analyze-case-status" hidden role="status" aria-live="polite">
      <span class="spinner" aria-hidden="true"></span>
      Analyzing case… correlation and AI may take a few seconds.
    </p>
  </div>
</section>

<script>
(function () {
  const form = document.getElementById("analyze-case-form");
  const status = document.getElementById("analyze-case-status");
  const submit = document.getElementById("analyze-case-submit");
  if (!form || !status || !submit) return;

  form.addEventListener("submit", function () {
    submit.disabled = true;
    submit.setAttribute("aria-busy", "true");
    status.hidden = false;
    document.body.classList.add("is-analyzing");
  });
})();
</script>

<section class="card">
  <h2>Case metadata</h2>

  <% if @debugging_case.description.present? || @debugging_case.customer_reference.present? || @debugging_case.environment.present? %>
    <ul class="meta-list">
      <% if @debugging_case.description.present? %>
        <li><strong>Description:</strong> <%= @debugging_case.description %></li>
      <% end %>
      <% if @debugging_case.customer_reference.present? %>
        <li><strong>Customer reference:</strong> <%= @debugging_case.customer_reference %></li>
      <% end %>
      <% if @debugging_case.environment.present? %>
        <li><strong>Environment:</strong> <%= @debugging_case.environment %></li>
      <% end %>
    </ul>
  <% else %>
    <p class="card__hint">No additional metadata recorded for this case.</p>
  <% end %>
</section>

<%= render "correlation_signals", correlation_signals: @correlation_signals %>
<%= render "ai_report", ai_report: @ai_report, structured: @ai_report_structured, debugging_case: @debugging_case %>

<%= render "redaction_summary", summary: @redaction_summary %>

<section class="card">
  <h2>Sanitized log sources</h2>
  <p class="card__hint">Raw content is not stored. Select all and copy from each field to reuse sanitized logs elsewhere.</p>

  <% @log_sources.each do |source| %>
    <article class="log-source">
      <h3><%= source.name.presence || source.source_type.humanize %></h3>
      <textarea readonly rows="10" aria-label="Sanitized log for <%= source.name.presence || source.source_type.humanize %>"><%= source.sanitized_content %></textarea>
    </article>
  <% end %>
</section>
