<div class="auth-card">
  <header class="page-header">
    <h1>Create your SafeLog AI account</h1>
    <p class="page-header__lead">Register with email and password to start sanitizing and analyzing debugging cases.</p>
  </header>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "form-panel" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="form-field">
      <%= f.label :email %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true %>
    </div>

    <div class="form-field">
      <%= f.label :password %>
      <% if @minimum_password_length %>
        <span class="form-hint"><%= @minimum_password_length %> characters minimum</span>
      <% end %>
      <%= f.password_field :password, autocomplete: "new-password", required: true %>
    </div>

    <div class="form-field">
      <%= f.label :password_confirmation %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", required: true %>
    </div>

    <div class="form-actions">
      <%= f.submit "Create account", class: "btn" %>
    </div>
  <% end %>

  <%= render "devise/shared/links" %>
</div>
